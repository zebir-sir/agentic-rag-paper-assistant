# API Configuration
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8888
API_URL=http://api:8888

# First-build dependency mirrors. Override only when your network requires it.
PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
HF_ENDPOINT=https://hf-mirror.com

# POSTGRES VECTOR DB CONFIGURATION
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vector_db

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
INGESTION_QUEUE_NAME=ingestion_tasks
INGESTION_MAX_RETRIES=3
INGESTION_DLQ_NAME=ingestion_tasks_dlq

# Redis cache
REDIS_URL=redis://redis:6379/0
ENABLE_REDIS_CACHE=true
EMBEDDING_CACHE_TTL_SECONDS=86400

# API engineering options
REQUEST_ID_HEADER=X-Request-ID
ENABLE_SECURITY_HEADERS=true
ENABLE_API_RATE_LIMIT=false
CHAT_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=10
ALLOWED_HOSTS=*
ENABLE_REQUEST_SIZE_LIMIT=true
CHAT_MAX_REQUEST_BODY_BYTES=262144
UPLOAD_MAX_REQUEST_BODY_BYTES=47185920
CHAT_METRICS_MAX_RECENT=50
# Runtime diagnostics:
# GET /system/runtime
# GET /system/metrics
# GET /system/chat-metrics

# OpenAI API Configuration
OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=your_base_url
LLM_CHOICE=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# OpenAlex Configuration
OPENALEX_API_KEY=your_openalex_key
OPENALEX_MAILTO=you@example.com

# General web search is optional.
# It is used for general technical/web questions, not OpenAlex paper discovery.
# If these variables are not configured, the system still works and search_web returns empty results.
# OpenAlex and general web search are two separate tools.
GENERAL_WEB_SEARCH_ENABLED=false
GENERAL_WEB_SEARCH_PROVIDER=custom
GENERAL_WEB_SEARCH_API_KEY=your-web-search-key
GENERAL_WEB_SEARCH_ENDPOINT=https://example.com/search

# External retrieval resilience. The circuit state is process-local and resets when the API restarts.
EXTERNAL_RETRIEVAL_MAX_RETRIES=1
EXTERNAL_RETRIEVAL_RETRY_BACKOFF_SECONDS=0.4
EXTERNAL_RETRIEVAL_CIRCUIT_FAILURE_THRESHOLD=3
EXTERNAL_RETRIEVAL_CIRCUIT_COOLDOWN_SECONDS=60

# Agent backend selection

# Structured session memory. Snapshots are stored in PostgreSQL JSONB,
# while only completed user/assistant turns marked memory_eligible are used.
MEMORY_CONTEXT_BUDGET_TOKENS=28000
MEMORY_COMPACTION_TRIGGER_TOKENS=30000
MEMORY_RECENT_TURNS=8
MEMORY_UPDATE_TURN_INTERVAL=8
